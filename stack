#!/usr/bin/env bash
#
# Pi-hole w/Unbound. A StatefulSet with one replica per labelled node, each pod running
# Pi-hole with its own Unbound, behind a kube-vip LoadBalancer IP.

# Variables substituted in k8s/*.yaml, anything else (e.g. $ in a regex) is left alone.
K8S_TEMPLATE_VARS='$STACK $PIHOLE_IMAGE $UNBOUND_IMAGE $UNBOUND_DNS_PORT $PIHOLE_REPLICAS $PIHOLE_LB_IP $PIHOLE_LOCAL_DNS_RECORDS $PIHOLE_LOCAL_DNS_DOMAINS $PIHOLE_CONFIG_CHECKSUM'

# -----------------------------------------------------
# Helper functions
# -----------------------------------------------------

function check_stack_context {
  if [[ -z "${PIHOLE_WEB_ADMIN_PASS:-}" ]]; then
    log_warning "PIHOLE_WEB_ADMIN_PASS isn't set, web UI will be accessible without authentication."
  fi

  if [[ -z "${PIHOLE_LB_IP:-}" ]]; then
    log_warning "PIHOLE_LB_IP isn't set, DNS will only be reachable inside the cluster."
  else
    k8s_warn_kube_vip
  fi
}

function render {
  envsubst "$K8S_TEMPLATE_VARS" < "$STACK_PATH/k8s/$1"
}

# Every name the web UI is reached by: the service, each pod and the nginx hostnames.
function cert_names {
  local i

  echo "pihole.$DOMAIN pihole-web pihole-web.$K8S_NAMESPACE.svc pihole-web.$K8S_NAMESPACE.svc.cluster.local"
  for ((i = 0; i < PIHOLE_REPLICAS; i++)); do
    echo "pihole$((i + 1)).$DOMAIN pihole-$i.pihole.$K8S_NAMESPACE.svc pihole-$i.pihole.$K8S_NAMESPACE.svc.cluster.local"
  done
}

function build_secrets {
  local names
  names=$(cert_names | xargs)

  if [[ ! -f "$SECRETS/ca.crt" || ! -f "$SECRETS/ca.key" ]]; then
    make-ca pihole -o "$SECRETS"
    make-truststore pihole "$SECRETS/ca.crt" -o "$SECRETS"
  fi

  # Regenerated when the names change, e.g. when a replica is added.
  if [[ ! -f "$SECRETS/pihole.crt" || ! -f "$SECRETS/pihole.key" || "$(cat "$SECRETS/pihole.names" 2> /dev/null)" != "$names" ]]; then
    make-cert pihole "$names" -o "$SECRETS" --ca-crt "$SECRETS/ca.crt" --ca-key "$SECRETS/ca.key"
    echo "$names" > "$SECRETS/pihole.names"
  fi

  cat "$SECRETS/pihole.crt" "$SECRETS/pihole.key" > "$SECRETS/pihole.pem"
}

# A local=/name/ line for each local DNS record, so Pi-hole answers every query type for those
# names itself (e.g. an empty AAAA or HTTPS answer) instead of forwarding them upstream.
function local_dns_domains {
  tr ';' '\n' <<< "$PIHOLE_LOCAL_DNS_RECORDS" | awk 'NF { printf "local=/%s/;", $2 }'
}

# Everything that needs a restart when it changes.
function config {
  local secret_args=(
    --from-file=pihole.pem="$SECRETS/pihole.pem"
    --from-literal=password="${PIHOLE_WEB_ADMIN_PASS:-}"
  )

  # App password hash (from pihole.toml) for API clients like homepage, shared by every replica.
  if [[ -n "${PIHOLE_API_APP_PWHASH:-}" ]]; then
    secret_args+=(--from-literal=app-pwhash="$PIHOLE_API_APP_PWHASH")
  fi

  kubectl create secret generic pihole "${secret_args[@]}" --dry-run=client -o yaml
  echo "---"
  kubectl create configmap unbound \
    --from-file=unbound.conf="$CONFIGS/unbound.conf" \
    --from-file=pihole.conf="$CONFIGS/pihole.conf" \
    --from-file=trust-anchor.conf="$CONFIGS/trust-anchor.conf" \
    --from-file=access-control.conf="$CONFIGS/access-control.conf" \
    --dry-run=client -o yaml
  echo "---"
  kubectl create configmap pihole-scripts \
    --from-file=sync-lists.sh="$STACK_PATH/k8s/sync-lists.sh" \
    --dry-run=client -o yaml
  echo "---"
  render settings.yaml
}

# -----------------------------------------------------
# Stack functions
# -----------------------------------------------------

function stack_check_env {
  if [ ! -d "$CONFIGS" ] || [ ! -d "$SECRETS" ]; then
    echo "Configs or secrets directory are missing from '$ENVIRONMENT_BASE'."
    exit 1
  fi
}

function stack_discover {
  export PIHOLE_REPLICAS=$(count "$PIHOLE_NODES")
}

function stack_env {
  echo
  echo "PIHOLE IMAGE  = $PIHOLE_IMAGE"
  echo "UNBOUND IMAGE = $UNBOUND_IMAGE"
  echo "PIHOLE NODES  = ($PIHOLE_REPLICAS)"
  list "$PIHOLE_NODES"
  echo
  echo "DNS IP        = $PIHOLE_LB_IP"
  echo
}

function stack_deploy {
  local manifests_config

  check_stack_context

  if (( PIHOLE_REPLICAS == 0 )); then
    log_error "No nodes are labelled ${STACK}_pihole."
    exit 1
  fi

  build_secrets

  export PIHOLE_LOCAL_DNS_DOMAINS=$(local_dns_domains)
  manifests_config=$(config)
  export PIHOLE_CONFIG_CHECKSUM=$(sha256sum <<< "$manifests_config" | cut -d' ' -f1)

  log_info "Deploying $PIHOLE_REPLICAS Pi-hole replica(s) to $K8S_NAMESPACE."
  {
    echo "$manifests_config"
    echo "---"
    # Synced live by each pod, so not part of the checksum.
    kubectl create configmap pihole-lists --from-file="$CONFIGS/lists/" --dry-run=client -o yaml
    echo "---"
    render services.yaml
    echo "---"
    render pihole.yaml
  } | kubectl apply --namespace "$K8S_NAMESPACE" -f -

  kubectl rollout status statefulset/pihole --namespace "$K8S_NAMESPACE" --timeout=15m
}
