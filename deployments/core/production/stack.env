# -----------------------------------------------------
# Deployment
# -----------------------------------------------------
THIS=$(realpath "$BASH_SOURCE")
HERE=$(dirname "$THIS")

export ENVIRONMENT_BASE=$(dirname "$THIS")
DEPLOYMENT_BASE=$(dirname "$ENVIRONMENT_BASE")

export ENVIRONMENT=$(basename "$ENVIRONMENT_BASE")
export DEPLOYMENT=$(basename "$DEPLOYMENT_BASE")

export CONFIGS="${ENVIRONMENT_BASE}/configs"
export SECRETS="${ENVIRONMENT_BASE}/secrets"

export STACK_PATH=$(realpath "$HERE/../../../")
export STACK_BASE=$(basename "$STACK_PATH" | sed 's/^stack\-//')
export STACK="${STACK_BASE}_${DEPLOYMENT}"

export CONTEXT="${ENVIRONMENT}.${DEPLOYMENT}"

# -----------------------------------------------------
# Images
# -----------------------------------------------------
# Pihole
PIHOLE_VERSION="2026.07.2"
export PIHOLE_IMAGE="pihole/pihole:${PIHOLE_VERSION}"

# Unbound
UNBOUND_VERSION="1.26.0-1"
export UNBOUND_IMAGE="madnuttah/unbound:${UNBOUND_VERSION}"

# -----------------------------------------------------
# Configuration
# -----------------------------------------------------
# Replicas run on nodes labelled pihole_core_pihole, one per node.

# LoadBalancer IPs in VLAN 111, announced by kube-vip.
export PIHOLE_LB_IP="192.168.111.100"
NGINX_LB_IP="192.168.111.101"  # stack-nginx
REDIS_LB_IP="192.168.111.102"  # stack-redis
RABBITMQ_LB_IP="192.168.111.103"  # stack-rabbitmq
RSYSLOG_LB_IP="192.168.111.104"  # stack-rsyslog

export UNBOUND_DNS_PORT="5335"

# Block lists and allow/deny domains are in configs/lists/.

# Every web service is reached through nginx, so they all follow NGINX_LB_IP. Services that
# aren't HTTP (e.g. Redis, the RabbitMQ broker, rsyslog) have their own LoadBalancer IP.
# The router UI isn't reachable from VLAN 111, so router.$DOMAIN points straight at it.
# nginx logs to rsyslog.$DOMAIN and won't start if it doesn't resolve.
export PIHOLE_LOCAL_DNS_RECORDS=$(cat <<EOF | tr -d '\n'
$NGINX_LB_IP alertmanager.$DOMAIN;
$NGINX_LB_IP auth.$DOMAIN;
$NGINX_LB_IP bazarr.$DOMAIN;
$NGINX_LB_IP grafana.$DOMAIN;
$NGINX_LB_IP homepage.$DOMAIN;
$NGINX_LB_IP jellyfin.$DOMAIN;
$NGINX_LB_IP lidarr.$DOMAIN;
$NGINX_LB_IP lldap.$DOMAIN;
$NGINX_LB_IP nas.$DOMAIN;
$NGINX_LB_IP omv.$DOMAIN;
$NGINX_LB_IP pihole.$DOMAIN;
$NGINX_LB_IP pihole1.$DOMAIN;
$NGINX_LB_IP pihole2.$DOMAIN;
$NGINX_LB_IP pihole3.$DOMAIN;
$NGINX_LB_IP profilarr.$DOMAIN;
$NGINX_LB_IP prowlarr.$DOMAIN;
$NGINX_LB_IP proxmox.$DOMAIN;
$NGINX_LB_IP qbittorrent.$DOMAIN;
$NGINX_LB_IP rabbitmq.$DOMAIN;
$NGINX_LB_IP radarr.$DOMAIN;
$NGINX_LB_IP seerr.$DOMAIN;
$NGINX_LB_IP sonarr.$DOMAIN;
$NGINX_LB_IP vault.$DOMAIN;
$NGINX_LB_IP vault1.$DOMAIN;
$NGINX_LB_IP vault2.$DOMAIN;
$NGINX_LB_IP vault3.$DOMAIN;
$NGINX_LB_IP vaultwarden.$DOMAIN;
$NGINX_LB_IP victorialogs.$DOMAIN;
$NGINX_LB_IP victoriametrics.$DOMAIN;
$NGINX_LB_IP vmalert.$DOMAIN;
$NGINX_LB_IP vmagent.$DOMAIN;

$RABBITMQ_LB_IP rabbitmq-broker.$DOMAIN;
$REDIS_LB_IP redis.$DOMAIN;
$RSYSLOG_LB_IP rsyslog.$DOMAIN;

192.168.50.1 router.$DOMAIN;

192.168.111.2 prx-001.$DOMAIN;
192.168.111.3 prx-002.$DOMAIN;
192.168.111.4 prx-003.$DOMAIN;

192.168.111.11 prx-001-srv-prod-core-control-001.$DOMAIN;
192.168.111.12 prx-001-srv-prod-core-worker-001.$DOMAIN;
192.168.111.13 prx-001-srv-prod-core-worker-002.$DOMAIN;
192.168.111.14 prx-001-srv-prod-core-worker-003.$DOMAIN;
192.168.111.15 prx-001-srv-prod-core-worker-004.$DOMAIN;

192.168.111.254 prx-001-srv-mgmt-001.$DOMAIN;

EOF
)
